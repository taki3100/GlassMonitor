<UserControl x:Class="GlassMonitor.Controls.StorageCardsTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GlassMonitor.Controls"
             xmlns:l="clr-namespace:GlassMonitor.Localization">
    <!-- DataContext: StorageDrivesViewModel。ディスクが 2〜4 台のとき、横幅を台数で等分したカードを並べる -->
    <ContentControl Style="{StaticResource GlassTile}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <c:TileHeader Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=c:StorageCardsTile}}" />

            <!-- カードの右側に 12 の間隔を付けるので、右端のぶんだけ外へはみ出させて等分にする -->
            <ItemsControl Grid.Row="1" Margin="0,10,-12,0" Focusable="False" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,12,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- DataContext: DriveCardViewModel -->
                        <Border Padding="12,9,12,8" CornerRadius="14" Background="#0FFFFFFF"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <!-- C: System          ● 48 °C -->
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Ellipse VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource TemperatureDot}" />
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource NumericText}">
                                            <Run FontSize="14" FontWeight="Bold" Text="{Binding TemperatureText, Mode=OneWay}" /><Run FontSize="4" Text=" " /><Run FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding TemperatureUnit, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run FontSize="13.5" FontWeight="Bold" Text="{Binding Letters, Mode=OneWay}" /><Run FontSize="11" Text="  " /><Run FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Label, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>

                                <TextBlock Margin="0,3,0,0" FontSize="10.5" Style="{StaticResource SecondaryText}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Description}"
                                           ToolTip="{Binding Description}" />

                                <ProgressBar Margin="0,7,0,4" Value="{Binding UsedPercent, Mode=OneWay}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource CapacityBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TempWarmBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <!-- 0.94 / 2.00 TB          47% -->
                                <DockPanel Height="19">
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                               Text="{Binding UsedPercentText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TempWarmBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Style="{StaticResource NumericText}" Text="{Binding CapacityText}" />
                                </DockPanel>

                                <DockPanel Height="19">
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                               Style="{StaticResource NumericText}" Text="{Binding ThroughputText}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Style="{StaticResource SecondaryText}"
                                               Text="{l:Loc Storage_ReadWrite}" />
                                </DockPanel>

                                <DockPanel Height="19">
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                               Text="{Binding HealthText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHealthCaution}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TempWarmBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Style="{StaticResource SecondaryText}"
                                               Text="{l:Loc Tile_Health}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ContentControl>
</UserControl>
