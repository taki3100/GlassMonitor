<UserControl x:Class="GlassMonitor.Controls.TileHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GlassMonitor.Controls">
    <!-- DataContext: TileViewModel -->
    <StackPanel Orientation="Horizontal">
        <Border Width="26" Height="26" CornerRadius="8" Style="{StaticResource GlassChip}">
            <c:GlyphIcon Width="15" Height="15"
                         Data="{Binding Icon, RelativeSource={RelativeSource AncestorType=c:TileHeader}}" />
        </Border>
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14.5" FontWeight="Bold"
                   Text="{Binding Title}" />
        <TextBlock Margin="9,1,0,0" VerticalAlignment="Center" FontSize="11"
                   Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                   Text="{Binding Subtitle}" />
    </StackPanel>
</UserControl>
