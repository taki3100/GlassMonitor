<UserControl x:Class="GlassMonitor.Controls.StorageTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GlassMonitor.Controls"
             xmlns:l="clr-namespace:GlassMonitor.Localization">
    <!-- DataContext: StorageTileViewModel。横幅いっぱいのタイルで、右側に読込/書込の 2 本線グラフ -->
    <ContentControl Style="{StaticResource GlassTile}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <c:TileHeader Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=c:StorageTile}}" />

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" MinWidth="380" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <c:TileSummary Margin="3,6,0,0" VerticalAlignment="Center" />

                <Rectangle Grid.Column="1" Width="1" Margin="20,4" Fill="{StaticResource DividerBrush}" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 凡例: 読込（実線）/ 書込（破線） -->
                    <StackPanel Orientation="Horizontal" TextElement.FontSize="11">
                        <Line X1="0" X2="14" Y1="0" Y2="0" VerticalAlignment="Center"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{l:Loc Storage_Read}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold"
                                   Style="{StaticResource NumericText}" Text="{Binding ReadText}" />

                        <Line Margin="24,0,0,0" X1="0" X2="14" Y1="0" Y2="0" VerticalAlignment="Center" Opacity="0.8"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="1.6,1.2" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{l:Loc Storage_Write}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold"
                                   Style="{StaticResource NumericText}" Text="{Binding WriteText}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right" Style="{StaticResource NumericText}">
                        <Run FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{l:Loc Storage_ActiveTime}" />
                        <Run FontSize="13.5" FontWeight="Bold" Text="{Binding ActivityText, Mode=OneWay}" />
                    </TextBlock>

                    <!-- 縦軸は 2 本で共有（GraphMaximum） -->
                    <Grid Grid.Row="2" Margin="0,4,0,4">
                        <c:Sparkline Values="{Binding ReadHistory}" Maximum="{Binding GraphMaximum}"
                                     AccentColor="{DynamicResource AccentColor}" />
                        <c:Sparkline Values="{Binding WriteHistory}" Maximum="{Binding GraphMaximum}"
                                     AccentColor="{DynamicResource AccentColor}"
                                     ShowArea="False" IsDashed="True" Opacity="0.8" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <TextBlock FontSize="10" Style="{StaticResource SecondaryText}" Text="{l:Loc Tile_SixtySecondsAgo}" />
                        <TextBlock HorizontalAlignment="Right" FontSize="10" Style="{StaticResource SecondaryText}" Text="{l:Loc Tile_Now}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
