<UserControl x:Class="GlassMonitor.Controls.TileSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GlassMonitor.Controls">
    <!-- DataContext: TileViewModel。リング / 主要値 / サブ情報 3 行 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="92" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.3*" MinWidth="134" />
        </Grid.ColumnDefinitions>

        <Grid Width="94" Height="94">
            <c:RingGauge Value="{Binding Usage}" Thickness="10" AccentColor="{DynamicResource AccentColor}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource NumericText}">
                    <Run FontSize="22" FontWeight="Bold" Text="{Binding UsageText, Mode=OneWay}" /><Run FontSize="11.5" FontWeight="SemiBold" Text="{Binding UsageUnit, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,-2,0,0" HorizontalAlignment="Center" FontSize="9.5"
                           Style="{StaticResource SecondaryText}" Text="{Binding UsageLabel}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="24,0,8,0" VerticalAlignment="Center">
            <TextBlock FontSize="11" Style="{StaticResource SecondaryText}" Text="{Binding PrimaryLabel}" />
            <!-- 「12.4 GB」「100 °C」など桁が増えても列からはみ出さないよう、入りきらない時だけ縮小する -->
            <Viewbox Margin="0,-2,0,0" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                <TextBlock Style="{StaticResource NumericText}" LineStackingStrategy="BlockLineHeight" LineHeight="52">
                    <Run FontSize="48" FontWeight="Bold" Text="{Binding PrimaryValue, Mode=OneWay}" /><Run FontSize="6" Text=" " /><Run FontSize="18" FontWeight="SemiBold" Text="{Binding PrimaryUnit, Mode=OneWay}" />
                </TextBlock>
            </Viewbox>
            <Border Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource TemperatureBadge}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" />
                    <TextBlock Margin="5,0,0,0" FontSize="11" Text="{Binding TemperatureText}" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,2,0,0" FontSize="11" Style="{StaticResource SecondaryText}"
                       Text="{Binding PrimaryNote}"
                       Visibility="{Binding PrimaryNote, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>

        <Rectangle Grid.Column="2" Width="1" Margin="10,2,20,2" Fill="{StaticResource DividerBrush}" />

        <ItemsControl Grid.Column="3" VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="30">
                        <TextBlock VerticalAlignment="Center" FontSize="11"
                                   Style="{StaticResource SecondaryText}" Text="{Binding Label}" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="13.5" FontWeight="Bold"
                                   Style="{StaticResource NumericText}" Text="{Binding Value}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
