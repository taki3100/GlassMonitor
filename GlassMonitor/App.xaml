<Application x:Class="GlassMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GlassMonitor"
             xmlns:c="clr-namespace:GlassMonitor.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- ===== フォント ===== -->
        <FontFamily x:Key="UiFont">Segoe UI, Yu Gothic UI</FontFamily>

        <!-- ===== アクセント（設定から Theme.ApplyAccent で差し替え） ===== -->
        <Color x:Key="AccentColor">#9BE7FF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#9BE7FF" />

        <!-- ===== 文字 ===== -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="DividerBrush" Color="#24FFFFFF" />

        <!-- ===== 温度 ===== -->
        <SolidColorBrush x:Key="TempNormalBrush" Color="#7FD9FF" />
        <SolidColorBrush x:Key="TempWarmBrush" Color="#FFB25C" />
        <SolidColorBrush x:Key="TempHotBrush" Color="#FF6262" />

        <!-- ===== ウィンドウ背景（Acrylic の上に重ねる色味） ===== -->
        <SolidColorBrush x:Key="WindowTintBrush" Color="#94100E32" />
        <SolidColorBrush x:Key="FallbackWindowBrush" Color="#FF17152E" />

        <RadialGradientBrush x:Key="GlowWarmBrush" Center="0.12,0.18" GradientOrigin="0.12,0.18" RadiusX="0.42" RadiusY="0.62">
            <GradientStop Color="#70FF6A3D" Offset="0" />
            <GradientStop Color="#00FF6A3D" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowTealBrush" Center="0.1,0.74" GradientOrigin="0.1,0.74" RadiusX="0.3" RadiusY="0.42">
            <GradientStop Color="#5532C6DC" Offset="0" />
            <GradientStop Color="#0032C6DC" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowBlueBrush" Center="1,0.52" GradientOrigin="1,0.52" RadiusX="0.4" RadiusY="0.7">
            <GradientStop Color="#703D6BFF" Offset="0" />
            <GradientStop Color="#003D6BFF" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowVioletBrush" Center="0.55,1.05" GradientOrigin="0.55,1.05" RadiusX="0.36" RadiusY="0.36">
            <GradientStop Color="#709B3DFF" Offset="0" />
            <GradientStop Color="#009B3DFF" Offset="1" />
        </RadialGradientBrush>

        <!-- ===== ガラス ===== -->
        <SolidColorBrush x:Key="GlassFillBrush" Color="#14FFFFFF" />
        <!-- 縁: 上側ほど明るく -->
        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0.3,1">
            <GradientStop Color="#4DFFFFFF" Offset="0" />
            <GradientStop Color="#1FFFFFFF" Offset="0.35" />
            <GradientStop Color="#14FFFFFF" Offset="0.75" />
            <GradientStop Color="#24FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <!-- 上部のうっすらとした光沢 -->
        <LinearGradientBrush x:Key="GlassGlossBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1FFFFFFF" Offset="0" />
            <GradientStop Color="#08FFFFFF" Offset="0.3" />
            <GradientStop Color="#00FFFFFF" Offset="0.55" />
        </LinearGradientBrush>
        <!-- 上端の細いハイライト線 -->
        <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#A6FFFFFF" Offset="0.25" />
            <GradientStop Color="#73FFFFFF" Offset="0.7" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <!-- ===== コンバーター ===== -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:TrueToCollapsedConverter x:Key="TrueToCollapsed" />

        <!-- ===== アイコン（24×24 の線画） ===== -->
        <Geometry x:Key="IconPulse">M2.5,12 H6.5 L9.5,5 L14.5,19 L17.5,12 H21.5</Geometry>
        <Geometry x:Key="IconCpu">M7,4.5 H17 A2.5,2.5 0 0 1 19.5,7 V17 A2.5,2.5 0 0 1 17,19.5 H7 A2.5,2.5 0 0 1 4.5,17 V7 A2.5,2.5 0 0 1 7,4.5 Z M9.5,9.5 H14.5 V14.5 H9.5 Z M9.5,1.5 V4.5 M14.5,1.5 V4.5 M9.5,19.5 V22.5 M14.5,19.5 V22.5 M1.5,9.5 H4.5 M1.5,14.5 H4.5 M19.5,9.5 H22.5 M19.5,14.5 H22.5</Geometry>
        <Geometry x:Key="IconGpu">M3.5,5.5 H20.5 A2,2 0 0 1 22.5,7.5 V16.5 A2,2 0 0 1 20.5,18.5 H3.5 A2,2 0 0 1 1.5,16.5 V7.5 A2,2 0 0 1 3.5,5.5 Z M5.5,9.5 H10.5 V14.5 H5.5 Z M14,12 A3,3 0 1 0 20,12 A3,3 0 1 0 14,12 Z</Geometry>
        <Geometry x:Key="IconMemory">M3.5,6.5 H20.5 A1.5,1.5 0 0 1 22,8 V15.5 H2 V8 A1.5,1.5 0 0 1 3.5,6.5 Z M6.5,9.5 V12.5 M10.5,9.5 V12.5 M13.5,9.5 V12.5 M17.5,9.5 V12.5 M5,15.5 V18.5 M9,15.5 V18.5 M15,15.5 V18.5 M19,15.5 V18.5</Geometry>
        <Geometry x:Key="IconDrive">M4.5,6.5 H19.5 A2,2 0 0 1 21.5,8.5 V15.5 A2,2 0 0 1 19.5,17.5 H4.5 A2,2 0 0 1 2.5,15.5 V8.5 A2,2 0 0 1 4.5,6.5 Z M6.5,12 H11.5 M15.5,12 V12.01 M18,12 V12.01</Geometry>
        <Geometry x:Key="IconLayers">M12,3.5 L21.5,8.5 L12,13.5 L2.5,8.5 Z M2.5,12.5 L12,17.5 L21.5,12.5 M2.5,16.5 L12,21.5 L21.5,16.5</Geometry>
        <Geometry x:Key="IconPin">M9,3 H15 M10,3 V9.5 L6.5,13.5 H17.5 L14,9.5 V3 M12,13.5 V21</Geometry>
        <Geometry x:Key="IconSliders">M3.5,8 H11 M17,8 H20.5 M11,8 A3,3 0 1 0 17,8 A3,3 0 1 0 11,8 Z M3.5,16 H7 M13,16 H20.5 M7,16 A3,3 0 1 0 13,16 A3,3 0 1 0 7,16 Z</Geometry>
        <Geometry x:Key="IconMinimize">M6,12 H18</Geometry>
        <Geometry x:Key="IconMaximize">M8,6 H16 A2,2 0 0 1 18,8 V16 A2,2 0 0 1 16,18 H8 A2,2 0 0 1 6,16 V8 A2,2 0 0 1 8,6 Z</Geometry>
        <Geometry x:Key="IconRestore">M7,9.5 H14.5 V17 H7 Z M9.5,7 H17 V14.5</Geometry>
        <Geometry x:Key="IconClose">M7,7 L17,17 M17,7 L7,17</Geometry>
        <Geometry x:Key="IconShield">M12,3 L19,5.8 V11 C19,15.4 16,18.7 12,20.5 C8,18.7 5,15.4 5,11 V5.8 Z</Geometry>
        <Geometry x:Key="IconWarning">M12,3.5 L21.5,20 H2.5 Z M12,10 V14 M12,17 V17.2</Geometry>

        <!-- タスクバー用のウィンドウアイコン -->
        <DrawingImage x:Key="AppIconImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2E3A8C" Offset="0" />
                                <GradientStop Color="#FF7A3FD6" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="{StaticResource IconPulse}">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF9BE7FF" Thickness="2.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===== スタイル ===== -->

        <Style TargetType="c:GlyphIcon">
            <Setter Property="SnapsToDevicePixels" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="c:GlyphIcon">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Data="{TemplateBinding Data}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="{TemplateBinding StrokeThickness}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数字は等幅 -->
        <Style x:Key="NumericText" TargetType="TextBlock">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!-- ガラスの小さな角丸チップ（アイコンの台座） -->
        <Style x:Key="GlassChip" TargetType="Border">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- タイルのガラス: 白 8% + 上部の光沢 + 上端のハイライト線 -->
        <Style x:Key="GlassTile" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="18" Background="{StaticResource GlassFillBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" />
                            <Border CornerRadius="17" Margin="1" Background="{StaticResource GlassGlossBrush}" />
                            <Border Height="1" Margin="26,0,26,0" VerticalAlignment="Top"
                                    Background="{StaticResource GlassHighlightBrush}" />
                            <ContentPresenter Margin="19,18,18,13" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- タイトルバーのボタン -->
        <Style x:Key="ChromeButtonBase" TargetType="ButtonBase">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Grid>
                            <Border CornerRadius="12" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <Border CornerRadius="11" Margin="1" Background="{StaticResource GlassGlossBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButtonBase}" />

        <Style x:Key="ChromeToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ChromeButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#3DFFFFFF" />
                    <Setter Property="BorderBrush" Value="#59FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0484D" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B0C42B30" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 温度バッジ（DataContext は TileViewModel） -->
        <Style x:Key="TemperatureBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,1,10,2" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TemperatureLevel}" Value="Normal">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="#307FD9FF" />
                    <Setter Property="BorderBrush" Value="#737FD9FF" />
                    <Setter Property="Tag" Value="{StaticResource TempNormalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TemperatureLevel}" Value="Warm">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="#38FFB25C" />
                    <Setter Property="BorderBrush" Value="#80FFB25C" />
                    <Setter Property="Tag" Value="{StaticResource TempWarmBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TemperatureLevel}" Value="Hot">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="#40FF6262" />
                    <Setter Property="BorderBrush" Value="#8CFF6262" />
                    <Setter Property="Tag" Value="{StaticResource TempHotBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 設定のトグルスイッチ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="22" CornerRadius="11"
                                    Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" Fill="#E6FFFFFF"
                                         HorizontalAlignment="Left" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF1A1934" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- アクセント色の見本（DataContext は AccentOption） -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="1.5" Opacity="0" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ウィンドウ中央に重ねるダイアログのカード -->
        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24,22,24,20" />
            <Setter Property="Background" Value="#F51B1A35" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダイアログのボタン（ガラス / アクセント） -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="#FF141327" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75" />
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- フッターのリンク風ボタン -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 文字の隙間もクリックできるよう透明の背景を敷く -->
                        <Border x:Name="Content" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ディスクの容量バー（空き容量が少ないときは Foreground をオレンジにする） -->
        <Style x:Key="CapacityBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="#26FFFFFF" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2.5"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 温度の小さな点（DataContext の TemperatureLevel で色を変える） -->
        <Style x:Key="TemperatureDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TemperatureLevel}" Value="Normal">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="{StaticResource TempNormalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TemperatureLevel}" Value="Warm">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="{StaticResource TempWarmBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TemperatureLevel}" Value="Hot">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="{StaticResource TempHotBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 温度しきい値の小さな入力欄 -->
        <Style x:Key="ThresholdBox" TargetType="TextBox" BasedOn="{StaticResource GlassTextBox}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="3" />
        </Style>

    </Application.Resources>
</Application>
